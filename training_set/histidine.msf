# histidine.msf — L-Histidine, triprotic amino acid
#
# Ionisation ladder (ascending pKa = descending n_protons):
#   pKa1 = 1.82  α-COOH → α-COO- + H+   (H3His2+ → H2His1+)
#   pKa2 = 6.00  ImH+   → Im    + H+    (H2His1+ → HHis0)
#   pKa3 = 9.17  α-NH3+ → α-NH2 + H+    (HHis0   → His1-)
#
# n_protons counts titratable H relative to His1- (n=0 reference).
# His1- retains α-NH2 (2 permanent H on α-N) — these are NOT titratable.
# The titratable proton at pKa3 is the THIRD H on α-N (NH2 → NH3+).
#
# H counts (all states have 82 electrons, multiplicity=1):
#   His1-   n=0 z=-1:  8H  (5 C-H + 2 α-NH2 + 1 Nε2-H)
#   HHis0   n=1 z= 0:  9H  +1H (α-NH3+: third H on α-N)
#   H2His1+ n=2 z=+1: 10H  +1H (Nδ1-H: Im → ImH+)
#   H3His2+ n=3 z=+2: 11H  +1H (O2-H: COO- → COOH)
#
# Permanent H in all states:
#   Cα-H, 2×Cβ-H, Cδ2-H, Cε1-H, 2×α-NH2-H, Nε2-H  (total 8)
# Titratable H added stepwise:
#   n=0→1: H on α-N  (third amine H)
#   n=1→2: H on Nδ1  (imidazolium)
#   n=2→3: H on O2   (carboxyl OH)

[microstate]
name         = His1-
charge       = -1
multiplicity = 1
n_protons    = 0
pka_step     = 9.17
functional_group = ammonium
# α-COO- + Im(neutral, Nε2-H) + α-NH2
# C6H8N3O2 1-  →  electrons = (36+8+21+16) - (-1) = 82  ✓

xyz =
N    0.2195  -1.1972  -0.7698
C    0.1040  -0.0064   0.0000
